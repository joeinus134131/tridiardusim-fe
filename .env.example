# URL Base API Backend (ArduSim Go Fiber Backend)
# Untuk development lokal:
NEXT_PUBLIC_API_URL=http://localhost:8080

# Untuk dev server staging / remote:
# NEXT_PUBLIC_API_URL=https://api-dev.domainanda.com
# atau
# NEXT_PUBLIC_API_URL=http://IP_SERVER_DEV:8080

# Tampilkan komponen eksperimental (robotik, AI, daya lanjutan) di library panel.
# Secara default hanya 10 tipe P0 yang ditampilkan (arduino_uno, breadboard, led_red,
# resistor_220, push_button, potentiometer, dht11, hcsr04, servo_sg90, jumper_*).
# Set ke true untuk menampilkan semua komponen termasuk yang eksperimental.
NEXT_PUBLIC_SHOW_EXPERIMENTAL=false
